<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ta_graphite"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_ta"
            android:padding="14dp"
            android:text="📅 Pick Date"
            android:textColor="@color/ta_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="📸 Take Photo"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnGallery"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🖼️ Gallery"
                android:textColor="@color/ta_white"
                android:textStyle="bold"
                app:strokeColor="@color/ta_champagne" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvOcrStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textColor="@color/ta_white"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/formContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ta"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <!-- Driver No -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Driver No"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etPlateNo"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:paddingHorizontal="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ta_white"
                    android:inputType="text"
                    android:gravity="end|center_vertical" />
            </LinearLayout>

            <!-- Shift Total -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Shift Total"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etShiftTotal"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:paddingHorizontal="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ta_white"
                    android:inputType="numberDecimal"
                    android:gravity="end|center_vertical" />
            </LinearLayout>

            <!-- Total Sharjah -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Total Sharjah"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etTotalSharjah"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:paddingHorizontal="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ta_white"
                    android:inputType="numberDecimal"
                    android:gravity="end|center_vertical" />
            </LinearLayout>

            <!-- Total Tollways -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Total Tollways"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etTotalTollways"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:paddingHorizontal="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ta_white"
                    android:inputType="numberDecimal"
                    android:gravity="end|center_vertical" />
            </LinearLayout>

            <!-- Shift Trips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Shift Trips"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etShiftTrips"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:paddingHorizontal="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ta_white"
                    android:inputType="number"
                    android:gravity="end|center_vertical" />
            </LinearLayout>

            <!-- Bookings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Bookings"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etBookings"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:paddingHorizontal="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ta_white"
                    android:inputType="number"
                    android:gravity="end|center_vertical" />
            </LinearLayout>

            <!-- Airport Trips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Airport Trips"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etAirportTrips"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:paddingHorizontal="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ta_white"
                    android:inputType="number"
                    android:gravity="end|center_vertical" />
            </LinearLayout>

            <!-- KM Hired -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="KM Hired"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etKmHired"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:paddingHorizontal="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ta_white"
                    android:inputType="numberDecimal"
                    android:gravity="end|center_vertical" />
            </LinearLayout>

            <!-- KM Vacant -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="KM Vacant"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etKmVacant"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:paddingHorizontal="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ta_white"
                    android:inputType="numberDecimal"
                    android:gravity="end|center_vertical" />
            </LinearLayout>

            <!-- Paid In Careem -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Paid In Careem"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etPaidInCareem"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:paddingHorizontal="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ta_white"
                    android:inputType="numberDecimal"
                    android:gravity="end|center_vertical" />
            </LinearLayout>

            <!-- Hala Peak -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Hala Peak"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etHalaPeak"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:paddingHorizontal="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ta_white"
                    android:inputType="numberDecimal"
                    android:gravity="end|center_vertical" />
            </LinearLayout>

            <!-- Tips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Tips"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etTips"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:paddingHorizontal="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ta_white"
                    android:inputType="numberDecimal"
                    android:gravity="end|center_vertical" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveShift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="52dp"
                android:text="💾 Save Shift"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
