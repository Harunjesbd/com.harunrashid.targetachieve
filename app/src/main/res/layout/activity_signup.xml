<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ta_graphite"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="@string/app_title"
            android:textColor="@color/ta_champagne"
            android:textSize="28sp"
            android:textStyle="bold|italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="32dp"
            android:text="@string/app_subtitle"
            android:textColor="@color/ta_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/label_your_name"
            android:textColor="@color/ta_champagne"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_edit_ta"
            android:hint="@string/hint_your_name"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:paddingHorizontal="14dp"
            android:textColor="@color/ta_white"
            android:textColorHint="#99FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/label_driver_id"
            android:textColor="@color/ta_champagne"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDriverId"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_edit_ta"
            android:hint="@string/hint_driver_id"
            android:importantForAutofill="no"
            android:inputType="number"
            android:paddingHorizontal="14dp"
            android:textColor="@color/ta_white"
            android:textColorHint="#99FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/label_mobile_number"
            android:textColor="@color/ta_champagne"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMobile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_edit_ta"
            android:hint="@string/hint_mobile_number"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:paddingHorizontal="14dp"
            android:textColor="@color/ta_white"
            android:textColorHint="#99FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/taxi_type"
            android:textColor="@color/ta_champagne"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgTaxiType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbShiftTaxi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/radio_shift_taxi"
                android:textColor="@color/ta_white"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbAirportTaxi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/radio_airport_taxi"
                android:textColor="@color/ta_white"
                android:textStyle="bold" />
        </RadioGroup>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_open_target_achieve"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnGoToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/ta_signup_to_login"
            android:textColor="@color/ta_champagne"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
