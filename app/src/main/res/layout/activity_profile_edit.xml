<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ta_graphite"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="Edit Profile &amp; Settings"
            android:textColor="@color/ta_champagne"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- দুটি ট্যাব -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="12dp"
                android:text="Edit Profile"
                android:textStyle="bold" />

            <View
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/tabSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="12dp"
                android:text="Settings"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== Edit Profile ===== -->
        <LinearLayout
            android:id="@+id/sectionProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Full Name"
                android:textColor="@color/ta_champagne"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_edit_ta"
                android:hint="Full Name"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:textColor="@color/ta_white"
                android:textColorHint="#88FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Driver No"
                android:textColor="@color/ta_champagne"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditDriverId"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_edit_ta"
                android:hint="Driver No"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/ta_white"
                android:textColorHint="#88FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEditMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:padding="8dp"
                android:text="Mobile"
                android:textColor="@color/ta_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/ta_champagne"
                android:minHeight="56dp"
                android:text="Save"
                android:textColor="#000000"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== Settings ===== -->
        <LinearLayout
            android:id="@+id/sectionSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calculation Rate"
                android:textColor="@color/ta_champagne"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRateTaxi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Rates for: -"
                android:textColor="@color/ta_white"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgRateMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbRateDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Default"
                    android:textColor="@color/ta_white"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbRateCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="Customize"
                    android:textColor="@color/ta_white"
                    android:textStyle="bold" />
            </RadioGroup>

            <!-- Shift Trips Rate -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:text="Shift Trips Rate"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etRateNormal"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:gravity="end|center_vertical"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ta_white"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bookings Rate -->
            <LinearLayout
                android:id="@+id/rowRateBooking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:text="Bookings Rate"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etRateBooking"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:gravity="end|center_vertical"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ta_white"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- KM Hired Rate (Each) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:text="KM Hired Rate (Each)"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etRateFuel"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:gravity="end|center_vertical"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ta_white"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Airport Trips Rate -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:text="Airport Trips Rate"
                    android:textColor="@color/ta_champagne"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etRateAirport"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_ta"
                    android:gravity="end|center_vertical"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ta_white"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRateNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Default = company rates. These values cannot be edited."
                android:textColor="#CFD3E6"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSaveRates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/ta_champagne"
                android:minHeight="52dp"
                android:text="Use Default Rates"
                android:textColor="#000000"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="14dp"
                android:background="@color/ta_inky_border" />

            <TextView
                android:id="@+id/btnViewSlabSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="📊 View Salary Slab"
                android:textColor="@color/ta_white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
